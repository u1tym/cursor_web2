# この機能の FastAPI 用。src/features/<feature-name>/backend/.env にコピーして値を埋める。
# 開発用 DB: localhost:5432 の tstdb。ユーザ tstuser。
# DB とユーザが無ければ、管理者 postgres で作る（手順は 13-db.mdc）。

Server=localhost
Database=tstdb
Port=5432
Username=tstuser
Password=TSTPASS

# この機能の Vue オリジン。カンマ区切り可。* は使わない。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# セッション有効期間（分）。認証する場合。値はシステムで揃える。
SESSION_TIMEOUT_MINUTES=30

# デバッグ専用。設定時はそのユーザ名をログイン済みとみなす。本番では空のまま。
# DEBUG_USER=alice

# ログのローテーション。1 ファイルの上限（バイト）と残す世代数。
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
