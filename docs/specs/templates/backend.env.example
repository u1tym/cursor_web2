# この機能の FastAPI 用。src/features/<feature-name>/backend/.env にコピーして値を埋める。
# 開発用 DB は既存の testdb を使う。

Server=localhost
Database=testdb
Port=5432
Username=testuser
Password=TESTUSER

# この機能の Vue オリジン。カンマ区切り可。* は使わない。
CORS_ORIGINS=http://localhost:5173

# セッション有効期間（分）。認証する場合。値はシステムで揃える。
SESSION_TIMEOUT_MINUTES=30

# デバッグ専用。設定時はそのユーザ名をログイン済みとみなす。本番では空のまま。
# DEBUG_USER=alice
